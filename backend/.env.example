# Backend environment template — copy to backend/.env and fill in values
# Keep NEXBIT_PRODUCTION=false only for local testing. Set true for real deployment.
NEXBIT_PRODUCTION=false

# MongoDB must support multi-document transactions for the matching engine.
# Use a replica set locally or MongoDB Atlas in production.
MONGO_URL="mongodb://localhost:27017/?replicaSet=rs0"
DB_NAME="nexbit_db"
CORS_ORIGINS="*"

# Real on-chain custody is fail-closed until explicitly configured.
NEXBIT_CUSTODY_ENABLED=false
NEXBIT_CUSTODY_PROVIDER="blockbee"

# Futures and Earn remain disabled until a real execution/yield provider is configured.
NEXBIT_FUTURES_ENABLED=false
NEXBIT_EARN_ENABLED=false

# Optional bootstrap override for the fee treasury. Prefer configuring it
# after login through POST /api/admin/fees/treasury.
# NEXBIT_FEE_TREASURY_USER_ID=""

# JWT — generate a strong random 64+ char secret for production.
JWT_SECRET="replace-with-a-strong-random-secret"

# Admin bootstrap credentials. Supply these only through the deployment environment.
ADMIN_EMAIL="replace-with-admin-email"
ADMIN_PASSWORD="replace-with-a-strong-admin-password"

EMAIL_FROM_NAME="NEXBIT"
# Resend sender address; use a verified domain for production.
EMAIL_FROM_ADDRESS="onboarding@resend.dev"
# Optional — Reply-To inbox you control
# EMAIL_REPLY_TO="support@yourdomain.com"

# Public base URL used in outbound email links
APP_URL="https://your-nexbit-domain.example.com"
